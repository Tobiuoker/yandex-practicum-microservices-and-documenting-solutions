@startuml
package "API Gateway" {
  entity User {
    * id : uuid
    --
    email : string
    name : string
    status : string
    created_at : datetime
  }

  entity House {
    * id : uuid
    --
    owner_user_id : uuid <<FK>>
    name : string
    address : string
    timezone : string
    created_at : datetime
  }
}

package "Device Registry Service" {
  entity Device {
    * id : uuid
    --
    house_id : uuid <<FK>>
    name : string
    type : string
    location : string
    serial_number : string
    status : string
    current_state_json : json
    created_at : datetime
    updated_at : datetime
  }

  entity DeviceCommand {
    * id : uuid
    --
    device_id : uuid <<FK>>
    requested_by : uuid <<FK>>
    capability : string
    command_type : string
    payload_json : json
    status : string
    idempotency_key : string
    created_at : datetime
    updated_at : datetime
  }
}

package "Telemetry Service" {
  entity TelemetryData {
    * id : uuid
    --
    device_id : uuid <<FK>>
    metric : string
    value : double
    unit : string
    observed_at : datetime
    quality : string
    created_at : datetime
  }
}

package "Scenarios Service" {
  entity Scenario {
    * id : uuid
    --
    house_id : uuid <<FK>>
    name : string
    enabled : boolean
    status : string
    created_at : datetime
    updated_at : datetime
  }

  entity ScenarioTrigger {
    * id : uuid
    --
    scenario_id : uuid <<FK>>
    source_device_id : uuid <<FK>>
    trigger_type : string
    condition_json : json
  }

  entity ScenarioAction {
    * id : uuid
    --
    scenario_id : uuid <<FK>>
    target_device_id : uuid <<FK>>
    action_type : string
    payload_json : json
  }
}

User ||--o{ House : owns
House ||--o{ Device : contains
Device ||--o{ DeviceCommand : receives
Device ||--o{ TelemetryData : produces
House ||--o{ Scenario : has
Scenario ||--o{ ScenarioTrigger : starts_by
Scenario ||--o{ ScenarioAction : executes
Device ||--o{ ScenarioTrigger : source (optional)
Device ||--o{ ScenarioAction : target
@enduml
